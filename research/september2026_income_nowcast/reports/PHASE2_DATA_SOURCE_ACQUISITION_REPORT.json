  "units_and_definitions": {
    "ACS_PUMS_money_income": {
      "unit": "inflation-adjusted annual dollars",
      "transform": "raw amount * ADJINC / 1e6; person sources summed for AGEP>=15; residual = HINCP*ADJINC/1e6 - sum of eight sources",
      "universe_this_backtest": "occupied housing units TYPEHUGQ==1, NP>0, WGTP>0 (not the R2.4 geography/bedroom/infant frame)",
      "kind": "observation"
    },
    "CPS_ASEC_2026": {
      "unit": "calendar-year 2025 household money income, current dollars",
      "weight_transform": "HSUP_WGT / 100",
      "kind": "observation_asec; not ACS; not September 2026"
    },
    "SSA_COLA": {
      "unit": "statutory percent increase payable in January of the stated year",
      "transform_used_in_backtest": "SSP and SSIP multiplied by (1+January COLA of T+1); coarse calendar overlay on ACS rolling 12-month income",
      "kind": "observation of Federal Register text; application to ACS sources is a projection/assumption"
    },
    "BLS_CES_AHE": {
      "unit": "dollars per hour, private industry jobs (Table B-3 extract only)",
      "kind": "job earnings observation; not household WAGP; full CES time series not acquired"
    },
    "BEA_personal_income": {
      "unit": "NIPA personal income, billions of dollars (PDF publication through August 2026)",
      "kind": "observation of PDF; machine-readable Table 2.6 monthly series not acquired"
    }
  },
